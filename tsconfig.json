{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "rewriteRelativeImportExtensions": true,
    "noImplicitReturns": true
  },
  "include": ["src", "scripts", "*.config.ts"],
  "exclude": ["astro.config.ts"]
}
